<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>RaidRecord</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- 与 ModMetaData 保持一致: 作者用于发布包命名, 版本号即模组版本 -->
        <ModAuthor>Suntion</ModAuthor>
        <Version>0.7.3</Version>

        <!-- 输出到 bin/{Configuration}/{AssemblyName}/, 不带 TFM 子目录 -->
        <OutputPath>bin/$(Configuration)/$(AssemblyName)/</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SPTarkov.Common" Version="4.0.8"/>
        <PackageReference Include="SPTarkov.DI" Version="4.0.8"/>
        <PackageReference Include="SPTarkov.Server.Core" Version="4.0.8"/>
        <PackageReference Include="SPTarkov.Server.Web" Version="4.0.8"/>
        <PackageReference Include="SuntionCore" Version="1.2.0" />
        <PackageReference Include="SuntionCore.SPTExtensions" Version="1.0.0" />
    </ItemGroup>

    <!-- 需要打包进发布包的数据文件, 资源文件 -->
    <ItemGroup>
        <DatabasePath Include="db/**/*.*"/>
        <WWWRootPath Include="wwwroot/**/*.*"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <Target Name="ZipRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
        <ReleaseDirectory>$(MSBuildProjectDirectory)/ReleaseZip/</ReleaseDirectory>
        <ZipOutput>$(ReleaseDirectory)$(ModAuthor)-$(AssemblyName)-$(Version).zip</ZipOutput>
        <ZipTempDir>$(IntermediateOutputPath)ReleaseZip/</ZipTempDir>
        </PropertyGroup>

        <!-- Create release directory -->
        <MakeDir Directories="$(ReleaseDirectory)" />

        <!-- Clean and create the temporary folder structure -->
        <RemoveDir Directories="$(ZipTempDir)" />
        <MakeDir Directories="$(ZipTempDir)SPT/user/mods/$(AssemblyName)" />

        <!-- Copy the release DLL into the correct SPT folder -->
        <ItemGroup>
            <ReleaseFiles Include="$(TargetDir)**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(ReleaseFiles)" DestinationFiles="@(ReleaseFiles->'$(ZipTempDir)SPT/user/mods/$(AssemblyName)/%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy SourceFiles="@(DatabasePath)" DestinationFiles="@(DatabasePath->'$(ZipTempDir)SPT/user/mods/$(AssemblyName)/db/%(RecursiveDir)%(Filename)%(Extension)')" />
        <Copy SourceFiles="@(WWWRootPath)" DestinationFiles="@(WWWRootPath->'$(ZipTempDir)SPT/user/mods/$(AssemblyName)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />

        <!-- Create the ZIP -->
        <ZipDirectory SourceDirectory="$(ZipTempDir)" DestinationFile="$(ZipOutput)" Overwrite="true" />

        <Message Importance="High" Text="Created release zip: $(ZipOutput)" />
    </Target>

</Project>
